# Board TYPE profile: Arduino UNO R4 WiFi (ABX00087) for the pio-arduino-unor4wifi skill.
# Sourced by scripts/*.sh. Same for every UNO R4 WiFi. The USB serial and COM port of ONE board on
# ONE PC are NOT here: discover.sh writes them to <apps>/.bench/uno-r4-wifi.env.

BOARD_ID=uno-r4-wifi
BOARD_NAME="Arduino UNO R4 WiFi"
BOARD_DEFINE=BOARD_UNO_R4_WIFI          # passed as -D to the app (build_flags)
BTN_LABELS=""                           # no user button (only RESET)
LED_LABELS="L"                          # LED1 = yellow L on D13 (P102)

# PlatformIO: registry platform pinned to an exact version (it pins the Arduino UNO R4 core and GCC)
PIO_VERSION=6.2                         # proven with PlatformIO Core 6.2.0
PIO_PLATFORM=platformio/renesas-ra@1.7.0
PIO_BOARD=uno_r4_wifi                   # board json: RA4M1 48 MHz, 256 KB flash, sketch at 0x4000, sam-ba upload
PIO_FRAMEWORK=arduino
PIO_ENV=uno_r4_wifi                     # [env:...] name in the generated platformio.ini
TOOLCHAIN_VERSION=1.70201.0             # toolchain-gccarmnoneeabi the platform pins (GCC 7.2.1; check_tools.sh)

# USB: the ESP32-S3 module is the USB bridge (CDC <-> RA4M1 UART, and the RA4M1 programmer)
USB_VID=2341
USB_PIDS_APP="1002"                     # UNO R4 WiFi bridge (sketch running and while uploading)
# Identity gate (bossac --info after a 1200 baud touch) - read 2026-10-08 on this board. The bridge
# EMULATES a SAM-BA loader: "Device" is a fixed placeholder, not the RA4M1 (whose id is readable only
# over SWD). The sketch's INFO line (board=uno-r4-wifi) confirms the target after flashing.
EXPECTED_LOADER="Arduino Bootloader (SAM-BA extended) 2.0"
EXPECTED_LOADER_DEVICE="nRF52840-QIAA"
APP_OFFSET=0x4000                       # sketch start (board json upload offset; the bridge maps bossac address 0 here)

CONSOLE_BAUD=115200
