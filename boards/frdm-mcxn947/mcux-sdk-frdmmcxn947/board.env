# Board TYPE profile: NXP FRDM-MCXN947 for the mcux-sdk-frdmmcxn947 skill.
# Sourced by scripts/*.sh. Same for every board of this type; the MCU-Link serial and COM port of
# ONE board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/frdm-mcxn947.env.

BOARD_ID=frdm-mcxn947
BOARD_NAME="NXP FRDM-MCXN947"
BOARD_DEFINE=BOARD_FRDM_MCXN947         # passed as -D to the app sources (board_files.cmake)
BTN_LABELS="SW2,SW3"                    # silkscreen names of BTN1,BTN2 (SW1 = reset; SW3 = ISP at reset)
LED_LABELS="RED,GREEN,BLUE"             # RGB LED D2, one colour per LEDn

# MCUXpresso SDK (GitHub, west workspace) - pinned. MCUX_SDK_ROOT (environment or ~/.fw-skills.env)
# overrides the default folder C:/mcux-<SDK_VERSION without the patch part>.
SDK_VERSION=26.09.00
SDK_BOARD=frdmmcxn947                   # SDK board id (west -b)
SDK_CORE=cm33_core0                     # M1 uses core 0 only (core 1 and the NPU wait for M3/M4)
SDK_DEVICE=MCXN947                      # device id in .vscode/mcuxpresso-tools.json
SDK_EXAMPLE=examples/demo_apps/hello_world   # exported by new_app.sh (west export_app), then trimmed
SDK_BOARD_DIR=frdmmcxn947               # board files folder inside the exported app
SDK_PINMUX_DIR=hello_world              # pin_mux.c/.h folder of the example (console + SWO pins)
SYSCLK_HZ=150000000                     # BOARD_InitBootClocks() = BOARD_BootClockPLL150M

# Build tools: MCUXpresso Installer (LOCAL, ~/.mcuxpressotools) + Kitware CMake. NEVER ST tools.
GCC_VERSION=14.2.rel1                   # arm-gnu-toolchain-<v>-mingw-w64-x86_64-arm-none-eabi
NINJA_VERSION=1.13.2                    # ninja-<v>
CMAKE_MIN=3.30                          # Kitware CMake, any version from this one on
LINKSERVER_VERSION=26.5.59              # C:/NXP/LinkServer_<v> (board stages, planned)
LINKSERVER_DEVICE="MCXN947:FRDM-MCXN947"
IDE_EXT_VERSION=26.9.44                 # MCUXpresso for VS Code version the IDE path was proven with

# Identity (LinkServer probe dapinfo, read 2026-10-29) - checked by discover.sh and flash.sh
EXPECTED_TARGET="MCXN947VDF"                 # dapinfo "Target Device Name"
EXPECTED_PROBE_BOARD="FRDM-MCXN947"         # dapinfo "Target Board Name"
PROBE_VID=1FC9                          # MCU-Link (CMSIS-DAP + VCOM)
PROBE_PID=0143                          # MCU-Link VCOM (read 2026-10-29, firmware 3.128)

CONSOLE_BAUD=115200
