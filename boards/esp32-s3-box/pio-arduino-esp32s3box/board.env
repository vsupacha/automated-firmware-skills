# Board TYPE profile: Espressif ESP32-S3-BOX (2021 model) for the pio-arduino-esp32s3box skill.
# Sourced by scripts/*.sh. Same for every ESP32-S3-BOX. The USB serial (= MAC address) and COM port
# of ONE board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/esp32-s3-box.env
# (the same bench file as the pio-espidf-esp32s3box skill - same physical board).

BOARD_ID=esp32-s3-box
BOARD_NAME="Espressif ESP32-S3-BOX"
BOARD_DEFINE=BOARD_ESP32_S3_BOX         # passed as -D to the app (build_flags)
BTN_LABELS="BOOT"                       # silkscreen names of BTN1,BTN2,... (test prompts)
LED_LABELS="LCD backlight"              # no user LED on the BOX: LED1 = the LCD backlight

# PlatformIO: registry platform pinned to an exact version (it pins arduino-esp32 2.0.17 and GCC 8.4)
PIO_VERSION=6.2                         # proven with PlatformIO Core 6.2.0
PIO_PLATFORM=platformio/espressif32@6.12.0
PIO_BOARD=esp32s3box                    # board json: 16 MB flash, qio_opi (octal PSRAM), USB CDC on boot (HWCDC)
PIO_FRAMEWORK=arduino
PIO_ENV=esp32_s3_box                    # [env:...] name in the generated platformio.ini
IDF_TARGET=esp32s3                      # esptool --chip

# Identity gate (esptool) - verified 2026-10-07 with the pio-espidf-esp32s3box skill
EXPECTED_CHIP=ESP32-S3
EXPECTED_FLASH=16MB
USB_VID=303A
USB_PIDS_APP="1001"                     # USB Serial/JTAG of the ESP32-S3 (ROM, bootloader and sketch)

CONSOLE_BAUD=115200                     # ignored by USB Serial/JTAG, kept for serial tools
