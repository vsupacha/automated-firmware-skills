# Board TYPE profile: Espressif ESP32-S3-BOX (2021 model) for the pio-espidf-esp32s3box skill. Sourced by
# scripts/*.sh. Same for every ESP32-S3-BOX. The USB serial (= MAC address) and COM port of ONE
# board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/esp32-s3-box.env.

BOARD_ID=esp32-s3-box
BOARD_NAME="Espressif ESP32-S3-BOX"
BOARD_DEFINE=BOARD_ESP32_S3_BOX         # passed as -D to the app (CMake, src/CMakeLists.txt)
BTN_LABELS="BOOT"                       # silkscreen names of BTN1,BTN2,... (test prompts)
LED_LABELS="LCD backlight"              # no user LED on the BOX: LED1 = the LCD backlight

# PlatformIO: registry platform pinned to an exact version (it pins ESP-IDF 5.5.0 and the toolchain)
PIO_VERSION=6.2                         # proven with PlatformIO Core 6.2.0
PIO_PLATFORM=platformio/espressif32@6.12.0
PIO_BOARD=esp32s3box                    # platform board json: 16 MB QIO flash, 0x303A:0x1001
PIO_FRAMEWORK=espidf
PIO_ENV=esp32_s3_box                    # [env:...] name in the generated platformio.ini
IDF_TARGET=esp32s3
# sdkconfig lines for this board (appended to the app's sdkconfig.defaults by new_app.sh)
SDKCONFIG_BOARD=sdkconfig.board         # file next to this board.env

# Identity gate (esptool, M3)
EXPECTED_CHIP=ESP32-S3
EXPECTED_FLASH=16MB                     # UNVERIFIED (vendor docs) - confirm with discover.sh
USB_VID=303A
USB_PIDS_APP="1001"                     # USB Serial/JTAG of the ESP32-S3 (ROM, bootloader and app)

CONSOLE_BAUD=115200                     # ignored by USB Serial/JTAG, kept for serial tools
