# Board TYPE profile: Raspberry Pi Pico 2 W for the pio-arduino-rpipico2w skill. Sourced by scripts/*.sh.
# Same for every Pico 2 W. The USB serial (= chip ID) and COM port of ONE board on ONE PC are NOT
# here: discover.sh writes them to <apps>/.bench/rpi-pico-2w.env.

BOARD_ID=rpi-pico-2w
BOARD_NAME="Raspberry Pi Pico 2 W"
BOARD_DEFINE=BOARD_RPI_PICO_2W          # passed as -D to the app (build_flags)
BTN_LABELS="BOOTSEL"                    # silkscreen names of BTN1,BTN2,... (test prompts)
LED_LABELS="LED (on the Wi-Fi module)"

# PlatformIO: pinned platform commit (it pins arduino-pico 6.1.0+4 fd65f6d4 and its toolchain)
PIO_VERSION=6.1                         # proven with PlatformIO Core 6.1.19
PIO_PLATFORM=https://github.com/maxgerhardt/platform-raspberrypi.git#5d4561a05e3b212660ac6fdd3fbfb328d1988aa1
PIO_BOARD=rpipico2w
PIO_FRAMEWORK=arduino
PIO_CORE=earlephilhower
PIO_ENV=rpi_pico_2w                     # [env:...] name in the generated platformio.ini

# Identity gate (picotool info in BOOTSEL)
EXPECTED_CHIP=RP2350
EXPECTED_FLASH=4096K
USB_VID=2E8A
USB_PID_BOOTSEL=000F
USB_PIDS_APP="F00F 00C0"                # arduino-pico sketch (board hwids)

CONSOLE_BAUD=115200
