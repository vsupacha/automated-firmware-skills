# Board TYPE profile: RT-Thread Edgi-Talk (PSOC Edge E84). Sourced by scripts/*.sh.
# Same for every Edgi-Talk board. Values of ONE physical board on ONE PC (probe serial,
# COM port) are NOT here: discover.sh writes them to <apps>/.bench/edgi-talk.env.
# Status: VERIFIED on hardware - hello-world-edgi, led-uart-ipc (2026-09-27), uart-btn-led (2026-10-03).

BOARD_ID=edgi-talk
BOARD_NAME="RT-Thread Edgi-Talk"
BOARD_DEFINE=BOARD_EDGI_TALK            # passed as -D to proj_cm33_ns / proj_cm55
BTN_LABELS="SW2"                        # silkscreen names of BTN1,BTN2,... (test prompts)

# Tools this profile was proven with
MTB_TOOLS_VERSION=3.9
PROGTOOLS_VERSION=1.9

# Base BSP (Project Creator board id) + pin
BSP_ID=KIT_PSE84_EVAL_EPC2
BSP_DIR=TARGET_APP_KIT_PSE84_EVAL_EPC2  # folder under bsps/ (new_app.sh auto-detects and warns)
BSP_VERSION=1.4.0                       # compared with bsps/<dir>/props.json core version
BSP_SOURCE=vendor                       # vendor BSP from Project Creator
# sha256 of the *unmodified* base design.modus; the overlay is only valid on top of this
BSP_BASE_MODUS_SHA256=baab4a9e8ea9876da9f876303075bf7e7aa025ca790f63fd8ae1d7b5b494b108
# Overlay: full replacement design.modus (clock tree ported to 12.288 MHz ECO). Empty = none.
BSP_OVERLAY_MODUS=design.modus
BSP_OVERLAY_MODUS_SHA256=97183d292c50d51377fb70ff8f5f8b9c5d0de3b475783f10c44250768b3dbc6e

# Template application (pinned)
APP_TEMPLATE_REPO=https://github.com/Infineon/mtb-example-psoc-edge-hello-world.git
APP_TEMPLATE_COMMIT=a4a17e27cd7ca35630a6ede798a2adc3390b77b9

# Silicon identity gate
EXPECTED_DEVICE=PSE846GPS2DBZC4A
EXPECTED_LIFECYCLE=DEVELOPMENT
OPENOCD_TARGET_CFG=target/infineon/pse84xgxs2.cfg   # EPC2 parts

# Console: SCB2 P6[5] RX / P6[7] TX -> KitProg3 USB-UART (port found via the probe serial)
CONSOLE_BAUD=115200

# Post-flash behaviour
POWER_CYCLE_AFTER_FLASH=0                # 1 = user must unplug/replug USB after flashing
