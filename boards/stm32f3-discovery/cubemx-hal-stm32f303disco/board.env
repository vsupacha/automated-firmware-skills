# Board TYPE profile: ST STM32F3DISCOVERY (STM32F303VC) for the cubemx-hal-stm32f303disco skill.
# Sourced by scripts/*.sh. Same for every board of this type; probe serial of one board on one PC
# is NOT here (discover.sh writes it to <apps>/.bench/stm32f3-discovery.env).

BOARD_ID=stm32f3-discovery
BOARD_NAME="ST STM32F3DISCOVERY"
BOARD_DEFINE=BOARD_STM32F3_DISCOVERY    # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="B1"
LED_LABELS="LD3,LD4,LD5,LD6,LD7,LD8,LD9,LD10"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_F3
FW_VERSION=1.11.6
FW_BSP=STM32F3-Discovery                # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=STM32F303VCT6
# Starting configuration: the CubeMX board configuration (pins labelled, LEDs as outputs, B1, SWD +
# SWO, board clock tree 48 MHz) without the board's other peripherals (MEMS, USB); then MX_CONFIG
# on top (';'-separated). CubeMX also has STM32F303C-DISC1 = the newer board with ST-LINK/V2-B + VCP.
MX_START="loadboard STM32F3DISCOVERY nomode"
MX_CONFIG="set mode SYS Trace_Asynchronous_SW"   # SWO on PB3: printf console through the ST-LINK
SYSCLK_HZ=48000000                      # board default clock tree (HSE from the ST-LINK MCO x PLL; SWO speed derives from it)

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
IDE_EXT_VERSION=3.11.0                  # STM32CubeIDE for VS Code version the IDE path was proven with (update_tools.sh)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=STM32F3DISCOVERY
VSCODE_CORE=Cortex-M4
# Board identity (discover.sh / flash.sh; read-only hot-plug connect)
EXPECTED_DEVICE_NAME="STM32F302xB-xC/STM32F303xB-xC"   # prefix of "Device name" (read 2026-11-12: STM32F302xB-xC/STM32F303xB-xC/F358xx)
EXPECTED_STLINK_BOARD=                  # empty: the on-board ST-LINK/V2 (FW V2J45S0) reports no board name
EXPECTED_DEVICE_ID=0x422                # read 2026-11-12 (rev Y)
PROBE_VID=0483
PROBE_PID=3748                          # ST-LINK/V2 (no VCP)
