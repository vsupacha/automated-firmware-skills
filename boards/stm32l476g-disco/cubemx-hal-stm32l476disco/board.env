# Board TYPE profile: ST STM32L476G-DISCO (32L476GDISCOVERY) for the cubemx-hal-stm32l476disco skill.
# Sourced by scripts/*.sh. Same for every board of this type; the ST-LINK serial and COM port of
# ONE board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/stm32l476g-disco.env.

BOARD_ID=stm32l476g-disco
BOARD_NAME="ST STM32L476G-DISCO (32L476GDISCOVERY)"
BOARD_DEFINE=BOARD_STM32L476G_DISCO     # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="JOY_CENTER,JOY_LEFT,JOY_RIGHT,JOY_UP,JOY_DOWN"   # BTN1..BTN5 = the 5-way joystick
LED_LABELS="LD4 (red),LD5 (green)"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_L4
FW_VERSION=1.18.2
FW_BSP=STM32L476G-Discovery             # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=STM32L476VGT6
# Starting configuration: the CubeMX board configuration (pins labelled, joystick, LEDs, SWD) without
# the board's other peripherals (LCD glass, audio, MEMS, QSPI); then MX_CONFIG on top (';'-separated).
MX_START="loadboard STM32L476G-DISCO nomode"
# console: USART2 on PD5/PD6 = the ST-LINK/V2-1 virtual COM port (115200 8N1 = CubeMX default)
MX_CONFIG="set mode USART2 Asynchronous;set pin PD5 USART2_TX;set pin PD6 USART2_RX"
SYSCLK_HZ=4000000                       # board default clock tree: MSI range 6 = 4 MHz, no PLL (generated code)

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
IDE_EXT_VERSION=3.11.0                  # STM32CubeIDE for VS Code version the IDE path was proven with (update_tools.sh)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=STM32L476G-DISCO
VSCODE_CORE=Cortex-M4

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME="STM32L4x1/STM32L475xx/STM32L476xx"   # prefix of "Device name" (read 2026-11-12: STM32L4x1/STM32L475xx/STM32L476xx/STM32L486xx)
EXPECTED_STLINK_BOARD=STM32L476G-DK     # "Board" the on-board ST-LINK/V2-1 reports (read 2026-11-12, FW V2J32M22)
EXPECTED_DEVICE_ID=0x415                # "Device ID", read from the board 2026-11-12 (rev 4)
PROBE_VID=0483
PROBE_PID=374B                          # ST-LINK/V2-1 with VCP

CONSOLE_BAUD=115200
