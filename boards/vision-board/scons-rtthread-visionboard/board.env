# Board TYPE profile: RT-Thread Vision Board (Renesas RA8D1) for the scons-rtthread-visionboard skill.
# Sourced by scripts/*.sh. Same for every Vision Board. The probe serial and COM port of ONE board
# on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/vision-board.env.

BOARD_ID=vision-board
BOARD_NAME="RT-Thread Vision Board (RA8D1)"
BOARD_DEFINE=BOARD_VISION_BOARD         # -D for the app (added to rtconfig.py CFLAGS by new_app.sh)
BTN_LABELS="KEY0 (P907)"                # silkscreen names of BTN1,... (test prompts; no commas in a label)
LED_LABELS="LED P102 (blue),LED P106,LED PA07"   # RGB LED, common anode: one pin per colour (P106/PA07 colours UNVERIFIED)

# SDK from RT-Thread Studio (repo/Extract): BSP + example project the app is copied from
BSP_VENDOR=RealThread
BSP_NAME=VISION-BOARD
BSP_VERSION=1.3.0                       # Board_Support_Packages/RealThread/VISION-BOARD/<version>
BSP_PROJECT=vision_board_blink_led      # projects/<name>: RT-Thread 5.0.2, msh, UART9 console, GPIO
GCC_VERSION=13.3                        # ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/<v>; new_app.sh sets Studio's
                                        # project to it too (the SDK project's 10.2.1 fails in Studio's build, owner 2026-10-09)
PYOCD_VERSION=0.2.9                     # Debugger_Support_Packages/RealThread/PyOCD/<v> (pyOCD 0.36.0 + Renesas.RA_DFP packs)

# Target and identity (pyOCD, read 2026-10-09 on this board type)
PYOCD_TARGET=R7FA8D1BH
PYOCD_FREQ=1000000                      # SWD Hz, as RT-Thread Studio's own flash command
PROBE_NAME="ART-Link CMSIS-DAP"         # pyocd list "Probe/Board" (contains)
PROBE_VID=0416
PROBE_PID=7687                          # ART-Link: CMSIS-DAP + VCP (UART9) + mass storage
EXPECTED_CPUID=0x410FD232               # 0xE000ED00: Arm Cortex-M85 r0p2
CODE_FLASH_START=0x02000000             # app.hex must lie inside code flash (2 MB)
CODE_FLASH_END=0x02200000               # option-setting memory (0x0300A100.., 0x27030080..) is never written

CONSOLE_BAUD=115200                     # RT-Thread console uart9 (SCI9) -> ART-Link VCP
