# Board TYPE profile: Gravitech Cucumber S (ESP32-S2-WROVER, onboard sensors) for the
# pio-arduino-cucumber skill. Sourced by scripts/*.sh. Same for every Cucumber RS/RIS/MS/MIS. The USB
# serial, USB VID, MAC address and COM port of ONE board on ONE PC are NOT here: discover.sh writes them
# to <apps>/.bench/cucumber-s.env.

BOARD_ID=cucumber-s
BOARD_NAME="Gravitech Cucumber S"
BOARD_DEFINE=BOARD_CUCUMBER_S           # passed as -D to the app (build_flags)
BTN_LABELS="BOOT"                       # silkscreen names of BTN1,BTN2,... (test prompts)
LED_LABELS="LED (GPIO2)"                # LED1 = blue user LED; the RGB LED (GPIO18) is a separate driver

# PlatformIO: registry platform pinned to an exact version (it pins arduino-esp32 2.0.17 and GCC 8.4)
PIO_VERSION=6.2                         # proven with PlatformIO Core 6.2.x
PIO_PLATFORM=platformio/espressif32@6.12.0
PIO_BOARD=esp32-s2-saola-1              # board json: ESP32-S2, 4 MB flash, Serial = UART0 (no USB CDC on boot) - as the POC
PIO_FRAMEWORK=arduino
PIO_ENV=cucumber_s                      # [env:...] name in the generated platformio.ini
IDF_TARGET=esp32s2                      # esptool --chip
# Libraries of the board-layer sensor drivers (exact versions). The LE380 POC ran BMP280 2.6.8, HTS221 0.1.5,
# Unified Sensor 1.1.13 on a Cucumber S; its MPU6050 2.2.4 / BusIO 1.14.3 are not in the PlatformIO
# registry, so the nearest 2023 releases 2.2.6 / 1.14.5 are pinned instead.
# Dependencies of the Adafruit drivers are pinned too (MPU6050 pulls GFX + SSD1306 for its examples),
# so a rebuild picks the same code.
PIO_LIB_DEPS="adafruit/Adafruit MPU6050@2.2.6|adafruit/Adafruit BMP280 Library@2.6.8|adafruit/Adafruit HTS221@0.1.5|adafruit/Adafruit Unified Sensor@1.1.13|adafruit/Adafruit BusIO@1.14.5|adafruit/Adafruit GFX Library@1.11.7|adafruit/Adafruit SSD1306@2.5.7"
# Network library of the iot-sensor template only (MQTT client)
PIO_LIB_DEPS_NET="knolleary/PubSubClient@2.8"

# Onboard I2C bus (the sensors): SDA GPIO41, SCL GPIO40 (Gravitech pinout + cucumber-library)
I2C_SDA=41
I2C_SCL=40
I2C_ADDRS="0x5F 0x68 0x76"              # HTS221, MPU6050, BMP280 - the i2c? command must list them

# Identity gate (esptool)
EXPECTED_CHIP=ESP32-S2
EXPECTED_FLASH=4MB
# Console = UART0 (GPIO43/44) through the board's USB-UART bridge (micro-USB "UART" port). The
# bridge chip is not fixed here: discover.sh lists every USB serial port, records the selected
# one's VID + USB serial in the bench file, and gates on the chip's MAC. Empty = any USB serial port.
USB_VID=                                # UNVERIFIED: bridge chip not read on hardware yet
USB_PIDS_APP=""                         # empty = no PID gate (a bridge keeps its PID in every mode)

CONSOLE_BAUD=115200
