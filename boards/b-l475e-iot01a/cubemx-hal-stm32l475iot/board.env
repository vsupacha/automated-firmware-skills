# Board TYPE profile: ST B-L475E-IOT01A (Discovery kit IoT node) for the cubemx-hal-stm32l475iot skill.
# Sourced by scripts/*.sh. Same for every board of this type; the ST-LINK serial and COM port of
# ONE board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/b-l475e-iot01a.env.

BOARD_ID=b-l475e-iot01a
BOARD_NAME="ST B-L475E-IOT01A (Discovery kit IoT node)"
BOARD_DEFINE=BOARD_B_L475E_IOT01A       # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="B1 USER (blue)"             # silkscreen names of BTN1,BTN2,... (comma-separated: no commas inside a label)
LED_LABELS="LED2"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_L4
FW_VERSION=1.18.2
FW_BSP=B-L475E-IOT01                    # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=STM32L475VGT6
# Starting configuration: the CubeMX board configuration (pins labelled, clocks 80 MHz, SWD) without
# the board's other peripherals; then MX_CONFIG on top (';'-separated). The two board variants
# B-L475E-IOT01A1 / -A2 have the same CubeMX configuration (only the board= line differs).
MX_START="loadboard B-L475E-IOT01A1 nomode"
# console: USART1 on PB6/PB7 = the ST-LINK/V2-1 virtual COM port (115200 8N1 = CubeMX default)
MX_CONFIG="set mode USART1 Asynchronous;set pin PB6 USART1_TX;set pin PB7 USART1_RX"
SYSCLK_HZ=80000000                      # board default clock tree

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=B-L475E-IOT01A1
VSCODE_CORE=Cortex-M4

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME="STM32L4x1/STM32L475xx"   # prefix of "Device name" (read 2026-10-08: STM32L4x1/STM32L475xx/STM32L476xx/STM32L486xx)
EXPECTED_STLINK_BOARD=STM32L4IO        # "Board" the on-board ST-LINK/V2-1 reports (read 2026-10-08)
EXPECTED_DEVICE_ID=0x415                 # "Device ID", read from the board 2026-10-08 (STM32L47x/L48x)
PROBE_VID=0483
PROBE_PID=374B                          # ST-LINK/V2-1 with VCP

CONSOLE_BAUD=115200
