# Board TYPE profile template for the cubemx-hal-stm32n6570dk skill (STM32N6 boards supported by
# STM32CubeMX and the STM32CubeN6 package). Copy boards/_template to boards/<id> (or
# <project>/boards/<id> for your own board) and fill in. Leave unknown values empty (scripts stop
# with a clear message); mark guesses "# UNVERIFIED". No probe serial / COM port here.

BOARD_ID=                               # folder name, e.g. nucleo-n657x0-q
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_NUCLEO_N657X0_Q; also map it in templates/_common/src/board/board.h + board.c
BTN_LABELS=""
LED_LABELS=""

CUBEMX_VERSION=6.18.1
CUBEMX_BOARD=""                         # board name in the CubeMX board database
MCU_CPN=
FW_PACKAGE=STM32Cube_FW_N6
FW_VERSION=1.4.1
PROJECT_STRUCTURE=FSBL_ONLY
MX_TEMPLATE_IOC=                        # ST's FSBL-only Template.ioc for this board in the package
MX_CONFIG=""                            # CubeMX commands for the console UART (set context/mode/pin ...)

GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0

CONSOLE_BAUD=115200
