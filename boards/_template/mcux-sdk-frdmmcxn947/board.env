# Board TYPE profile template for the mcux-sdk-frdmmcxn947 skill (NXP MCX N + MCUXpresso SDK).
# Copy to <project>/boards/<id>/mcux-sdk-frdmmcxn947/board.env and fill in the empty values.
# Pins come from the SDK board files (examples/_boards/<sdk-board>/) or your schematic; the
# board layer (templates/_common/src/board/board.c) needs a #if block for the new BOARD_DEFINE.

BOARD_ID=
BOARD_NAME=
BOARD_DEFINE=
BTN_LABELS=
LED_LABELS=

# MCUXpresso SDK - pinned
SDK_VERSION=26.09.00
SDK_BOARD=
SDK_CORE=cm33_core0
SDK_DEVICE=
SDK_EXAMPLE=examples/demo_apps/hello_world
SDK_BOARD_DIR=
SDK_PINMUX_DIR=hello_world
SYSCLK_HZ=

# Build tools (MCUXpresso Installer + Kitware CMake) - never ST tools
GCC_VERSION=14.2.rel1
NINJA_VERSION=1.13.2
CMAKE_MIN=3.30
LINKSERVER_VERSION=26.5.59
LINKSERVER_DEVICE=
IDE_EXT_VERSION=26.9.44

EXPECTED_TARGET=
EXPECTED_PROBE_BOARD=
PROBE_VID=1FC9

CONSOLE_BAUD=115200
