# Board TYPE profile template for the scons-rtthread-visionboard skill (RA boards with an RT-Thread
# Studio SDK whose example project builds with scons). Copy boards/_template to boards/<id> (or
# <project>/boards/<id> for your own board) and fill in. Leave unknown values empty (scripts stop
# with a clear message); mark guesses "# UNVERIFIED". Do not put the probe serial / COM port here:
# discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. vision-board
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_VISION_BOARD; also map it in templates/_common/src/board/board_io.h + .c
BTN_LABELS=""                           # silkscreen names of BTN1,... (no commas inside a label)
LED_LABELS=""

BSP_VENDOR=                             # repo/Extract/Board_Support_Packages/<vendor>/<name>/<version>
BSP_NAME=
BSP_VERSION=
BSP_PROJECT=                            # projects/<name> the app is copied from (RT-Thread + msh + GPIO)
GCC_VERSION=13.3                        # ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/<v>
PYOCD_VERSION=0.2.9                     # Debugger_Support_Packages/RealThread/PyOCD/<v>

PYOCD_TARGET=                           # e.g. R7FA8D1BH (pyocd list --targets with the packs)
PYOCD_FREQ=1000000
PROBE_NAME=""                           # pyocd list "Probe/Board" (contains)
PROBE_VID=
PROBE_PID=
EXPECTED_CPUID=                         # read32 0xE000ED00
CODE_FLASH_START=                       # app.hex must lie inside code flash
CODE_FLASH_END=

CONSOLE_BAUD=115200
