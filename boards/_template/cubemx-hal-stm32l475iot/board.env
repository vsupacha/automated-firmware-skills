# Board TYPE profile template for the cubemx-hal-stm32l475iot skill (STM32L4 + classic STM32CubeMX).
# Copy to <project>/boards/<id>/cubemx-hal-stm32l475iot/board.env and fill in the empty values.
# Pins and labels come from the CubeMX board configuration or your schematic.

BOARD_ID=
BOARD_NAME=
BOARD_DEFINE=
BTN_LABELS=
LED_LABELS=

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_L4
FW_VERSION=1.18.2
FW_BSP=B-L475E-IOT01                    # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=
# Starting configuration: the CubeMX board configuration (pins labelled, clocks 80 MHz, SWD) without
# the board's other peripherals; then MX_CONFIG on top (';'-separated). The two board variants
# B-L475E-IOT01A1 / -A2 have the same CubeMX configuration (only the board= line differs).
MX_START=
# console: USART1 on PB6/PB7 = the ST-LINK/V2-1 virtual COM port (115200 8N1 = CubeMX default)
MX_CONFIG=
SYSCLK_HZ=

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=
VSCODE_CORE=Cortex-M4

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME=
EXPECTED_STLINK_BOARD=
EXPECTED_DEVICE_ID=
PROBE_VID=0483
PROBE_PID=374B                          # ST-LINK/V2-1 with VCP

CONSOLE_BAUD=115200
