# Board TYPE profile template for the pio-arduino-cucumber skill (ESP32-S2 boards with a USB-UART
# bridge console and a PlatformIO board json). Copy boards/_template to boards/<id> (or
# <project>/boards/<id> for your own board) and fill in. Leave unknown values empty (scripts stop with
# a clear message); mark guesses "# UNVERIFIED". Do not put the USB serial / MAC / COM port here:
# discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. cucumber-s
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_CUCUMBER_S; also map it in templates/_common/src/board/board.h + board.cpp
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 e.g. "BOOT"
LED_LABELS=""

PIO_VERSION=6.2
PIO_PLATFORM=platformio/espressif32@6.12.0
PIO_BOARD=                              # pio boards esp32s2 (e.g. esp32-s2-saola-1)
PIO_FRAMEWORK=arduino
PIO_ENV=                                # [env:...] name, e.g. cucumber_s
IDF_TARGET=esp32s2
PIO_LIB_DEPS=""                         # "owner/name@1.2.3|..." exact versions of the board drivers' libraries
PIO_LIB_DEPS_NET=""                     # libraries of network templates only

I2C_SDA=
I2C_SCL=
I2C_ADDRS=""                            # onboard I2C devices, e.g. "0x5F 0x68 0x76"

EXPECTED_CHIP=ESP32-S2
EXPECTED_FLASH=                         # e.g. 4MB (esptool flash_id)
USB_VID=                                # bridge VID (hex) or empty = any USB serial port
USB_PIDS_APP=""

CONSOLE_BAUD=115200
