# Board TYPE profile template for the cubemx2-hal2-stm32c562nucleo skill (STM32C5 boards known to STM32CubeMX2).
# Copy boards/_template to boards/<id> (or <project>/boards/<id> for your own board) and fill in.
# Leave unknown values empty (scripts stop with a clear message); mark guesses "# UNVERIFIED".
# Do not put the ST-LINK serial / COM port here: discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. nucleo-c5xxx
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_NUCLEO_C5XXX; add its #elif user-I/O table in templates/_common/src/board/board.c
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 e.g. "B1 (USER)"

MX_BOARD_CPN=                           # mx project create-from-board --cpn (board name in STM32CubeMX2)
MX_BOARD_PACK=                          # board pack name, e.g. nucleo-c562re_hw-board
MX_BOARD_PACK_VERSION=
MX_CONFIG="USART2:Async"                # peripherals to enable: the UART wired to the ST-LINK VCP
BUILD_TYPE=debug

MX_VERSION=1.1.1
NODE_VERSION=22.22.2+st.1
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2              # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2           # stlink-gdbserver (VS Code debug)
# STM32CubeIDE for VS Code project setup (mx/.settings/ide.store.json, written by regen.sh)
MCU_CPN=STM32C5xxxxx                    # full part number, as in the generated mx/cmake files
VSCODE_BOARD=                           # ST board name, empty for a custom board
VSCODE_CORE=Cortex-M33
VSCODE_SOURCE=                          # CubeMX2 projects: not recorded as classic STM32CubeMX
PACKS=""                                # <vendor>/<name>/<version> ... (dfp, hal_drivers, templates, board pack)

EXPECTED_DEVICE_NAME=STM32C5            # prefix of "Device name" (discover.sh prints it)
EXPECTED_DEVICE_ID=                     # "Device ID" from discover.sh, e.g. 0x44E
EXPECTED_STLINK_BOARD=                  # "Board" reported by an on-board ST-LINK; empty for external probes
PROBE_VID=0483
PROBE_PID=3754

CONSOLE_BAUD=115200
