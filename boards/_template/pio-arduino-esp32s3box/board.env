# Board TYPE profile template for the pio-arduino-esp32s3box skill (ESP32-S3 boards with a
# PlatformIO board json and an arduino-esp32 variant). Copy boards/_template to boards/<id> (or
# <project>/boards/<id> for your own board) and fill in. Leave unknown values empty (scripts stop with a clear message); mark guesses
# "# UNVERIFIED". Do not put the USB serial / COM port here: discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. esp32-s3-box-3
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_ESP32_S3_BOX_3; also map it in templates/_common/src/board/board.h + board.c
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 e.g. "BOOT"
LED_LABELS=""

PIO_VERSION=6.2
PIO_PLATFORM=platformio/espressif32@6.12.0
PIO_BOARD=                              # pio boards esp32s3 (e.g. esp32s3box, esp32-s3-devkitc-1)
PIO_FRAMEWORK=arduino
PIO_ENV=                                # [env:...] name, e.g. esp32_s3_box_3
IDF_TARGET=esp32s3

EXPECTED_CHIP=ESP32-S3
EXPECTED_FLASH=                         # e.g. 16MB (esptool flash_id)
USB_VID=303A
USB_PIDS_APP="1001"                     # USB Serial/JTAG; boards with a USB-UART bridge differ

CONSOLE_BAUD=115200
