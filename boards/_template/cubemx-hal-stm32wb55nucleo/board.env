# Board TYPE profile template for the cubemx-hal-stm32wb55nucleo skill (STM32WB + classic STM32CubeMX).
# Copy to <project>/boards/<id>/cubemx-hal-stm32wb55nucleo/board.env and fill in the empty values.
# Pins and labels come from the CubeMX board configuration or your schematic.

BOARD_ID=
BOARD_NAME=
BOARD_DEFINE=
BTN_LABELS=
LED_LABELS=

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_WB
FW_VERSION=1.24.0
FW_BSP=                                 # Drivers/BSP/<name> in the package (pin facts), e.g. P-NUCLEO-WB55.Nucleo
MCU_CPN=
# Starting configuration: the CubeMX board configuration (loadboard <board> nomode) or an MCU
# (load <mcu>); then MX_CONFIG on top (';'-separated).
MX_START=
# console: a USART on the ST-LINK virtual COM port pins (115200 8N1 = CubeMX default)
MX_CONFIG=
SYSCLK_HZ=

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
IDE_EXT_VERSION=3.11.0                  # STM32CubeIDE for VS Code version the IDE path was proven with (update_tools.sh)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=
VSCODE_CORE=Cortex-M4

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME=
EXPECTED_STLINK_BOARD=
EXPECTED_DEVICE_ID=
PROBE_VID=0483
PROBE_PID=374B                          # ST-LINK/V2-1 with VCP

CONSOLE_BAUD=115200
