# Board TYPE profile template for the pio-arduino-unor4wifi skill (RA4M1 boards with a PlatformIO
# board json in the renesas-ra platform and an ESP32-S3 USB bridge like the UNO R4 WiFi). Copy
# boards/_template to boards/<id> (or <project>/boards/<id> for your own board) and fill in. Leave
# unknown values empty (scripts stop with a clear message); mark guesses "# UNVERIFIED". Do not put
# the USB serial / COM port here: discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. uno-r4-wifi
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_UNO_R4_WIFI; also map it in templates/_common/src/board/board.h + board.cpp
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 (empty: no user button)
LED_LABELS=""                           # e.g. "L"

PIO_VERSION=6.2
PIO_PLATFORM=platformio/renesas-ra@1.7.0
PIO_BOARD=                              # pio boards ra4m1 (e.g. uno_r4_wifi)
PIO_FRAMEWORK=arduino
PIO_ENV=                                # [env:...] name, e.g. uno_r4_wifi
TOOLCHAIN_VERSION=1.70201.0             # toolchain-gccarmnoneeabi version the platform pins

USB_VID=2341
USB_PIDS_APP=""                         # e.g. "1002" (UNO R4 WiFi bridge); dfu-util boards differ - new flash path
EXPECTED_LOADER=""                      # bossac --info "Version" after a 1200 baud touch
EXPECTED_LOADER_DEVICE=""               # bossac --info "Device" (an emulated placeholder on the R4 WiFi)
APP_OFFSET=0x4000                       # board json upload offset_address

CONSOLE_BAUD=115200
