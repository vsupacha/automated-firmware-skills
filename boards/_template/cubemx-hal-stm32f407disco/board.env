# Board TYPE profile template for the cubemx-hal-stm32f407disco skill (STM32F4 boards in the
# STM32CubeMX board database). Copy to boards/<id>/ and fill in; mark guesses "# UNVERIFIED".
# No probe serial / COM port here.

BOARD_ID=                               # folder name, e.g. stm32f411e-disco
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_STM32F411E_DISCO; map it in templates/_common/src/board/board.h + board.c
BTN_LABELS=""
LED_LABELS=""

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_F4
FW_VERSION=1.28.3
FW_BSP=                                  # Drivers/BSP/<name>
MCU_CPN=
# Starting configuration: the CubeMX board configuration (pins labelled, LEDs as outputs, B1, SWD,
# board clock tree) without the board's other peripherals; then MX_CONFIG on top (';'-separated)
MX_START="loadboard <CubeMX board name> nomode"
MX_CONFIG="set mode SYS Trace_Asynchronous_SW"   # SWO on PB3: printf console through the ST-LINK
SYSCLK_HZ=

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2
GDBSERVER_VERSION=7.14.0+st.2
VSCODE_BOARD=                           # CubeMX board name (optional)
VSCODE_CORE=                            # e.g. Cortex-M4 (optional)
EXPECTED_DEVICE_ID=                     # STM32CubeProgrammer "Device ID"
