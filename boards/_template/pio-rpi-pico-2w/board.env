# Board TYPE profile template for the pio-rpi-pico-2w skill (RP2350 boards with an arduino-pico
# variant). Copy boards/_template to boards/<id> (or <project>/boards/<id> for your own board) and
# fill in. Leave unknown values empty (scripts stop with a clear message); mark guesses "# UNVERIFIED".
# Do not put the USB serial / COM port here: discover.sh <id> writes them per PC.

BOARD_ID=                               # folder name, e.g. my-rp2350-board
BOARD_NAME=""
BOARD_DEFINE=                           # e.g. BOARD_MY_RP2350_BOARD; also map it in templates/_common/src/board/board.h
BTN_LABELS=""                           # silkscreen names of BTN1,BTN2 e.g. "BOOTSEL"
LED_LABELS=""

PIO_VERSION=6.1
PIO_PLATFORM=https://github.com/maxgerhardt/platform-raspberrypi.git#5d4561a05e3b212660ac6fdd3fbfb328d1988aa1
PIO_BOARD=                              # pio boards rp2350 (e.g. rpipico2, rpipico2w)
PIO_FRAMEWORK=arduino
PIO_CORE=earlephilhower
PIO_ENV=                                # [env:...] name, e.g. my_rp2350_board

EXPECTED_CHIP=RP2350                    # picotool info "type"
EXPECTED_FLASH=                         # picotool info "flash size", e.g. 4096K
USB_VID=2E8A
USB_PID_BOOTSEL=000F
USB_PIDS_APP=""                         # hwids of the board json (pio boards <id> --json-output)

CONSOLE_BAUD=115200
