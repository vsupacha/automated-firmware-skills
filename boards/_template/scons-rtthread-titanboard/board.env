# Board TYPE profile template for the scons-rtthread-titanboard skill (RA8P1 boards with an RT-Thread
# Studio SDK whose example project builds with scons). Copy boards/_template to boards/<id> (or
# <project>/boards/<id> for your own board) and fill in. Leave unknown values empty (scripts stop
# with a clear message); mark guesses "# UNVERIFIED". Do not put the probe serial / COM port here:
# discover.sh <id> writes them per PC.
BOARD_ID=titan-board
BOARD_NAME="RT-Thread Titan Board (RA8P1)"
BOARD_DEFINE=BOARD_TITAN_BOARD          # -D for the app (added to rtconfig.py CFLAGS by new_app.sh)
BTN_LABELS="KEY (P110)"                 # silkscreen names of BTN1,... (test prompts; no commas in a label)
LED_LABELS="LED R (P013),LED B (P012),LED G (P613)"   # RGB LED, active low (BSP blink example: LED_ON = 0)

# SDK from RT-Thread Studio (repo/Extract): BSP + example project the app is copied from
BSP_VENDOR=RealThread
BSP_NAME=Titan-Board
BSP_VERSION=1.0.2                       # Board_Support_Packages/RealThread/Titan-Board/<version> (examples in project/)
BSP_PROJECT=Titan_template              # project/<name>: RT-Thread 5.1.0, msh, UART8 console; its FSP already
                                        # generates nearly every peripheral (ADC, CANFD, display, ether, I2C, OSPI,
                                        # RTC, SDHI, SPI, GPT, IPC ...) while Kconfig enables only GPIO + UART8
FSP_PROJECT=                            # empty: BSP_PROJECT's own FSP (see above)
GCC_VERSION=13.3                        # ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/<v> (the SDK's own setting)
PYOCD_VERSION=0.2.9                     # Debugger_Support_Packages/RealThread/PyOCD/<v> (Renesas.RA_DFP 6.1.0 has RA8P1)

# Target and identity (pyOCD, read 2026-10-31 on this board type)
PYOCD_TARGET=R7KA8P1KF
PYOCD_FREQ=1000000                      # SWD Hz
PYOCD_NOISE='Error probing AP#2|AttributeError: .NoneType. object has no attribute .group.'   # harmless pyOCD 0.36 messages on RA8P1
                                        # (AP#2 discovery, SVD parse of the pack) - flash.sh does not count them as errors
PROBE_NAME="RA4M2 CMSIS-DAP"            # pyocd list "Probe/Board" (contains): on-board probe (CMSIS-DAP v2, WinUSB)
PROBE_VID=045B                          # Renesas
PROBE_PID=201F                          # "RA4M2 CMSIS-DAP Probe": CMSIS-DAP v2 (WinUSB) + VCOM (UART8)
EXPECTED_CPUID=0x411FD231               # 0xE000ED00 of core 0: Arm Cortex-M85 r1p1 (read 2026-10-31)
CODE_FLASH_START=0x02000000             # app.hex must lie inside code MRAM (1 MB)
CODE_FLASH_END=0x02100000               # option-setting memory is never written

CONSOLE_BAUD=115200                     # RT-Thread console uart8 (P500 RX / P501 TX) -> DAP-Link VCP
