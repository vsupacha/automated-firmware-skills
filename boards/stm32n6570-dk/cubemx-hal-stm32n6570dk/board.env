# Board TYPE profile: ST STM32N6570-DK for the cubemx-hal-stm32n6570dk skill. Sourced by
# scripts/*.sh. Same for every STM32N6570-DK; probe serial / COM port of one board on one PC are
# NOT here (discover.sh writes them to <apps>/.bench/stm32n6570-dk.env).

BOARD_ID=stm32n6570-dk
BOARD_NAME="ST STM32N6570-DK"
BOARD_DEFINE=BOARD_STM32N6570_DK        # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="USER1"                      # BSP name BUTTON_USER1; silkscreen UNVERIFIED
LED_LABELS="LED1,LED2"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1                   # ~/.stm32cubemx/plugins/updater/updater.ini SoftVersion
CUBEMX_BOARD="STM32N6570-DK"            # board name in the CubeMX board database
MCU_CPN=STM32N657X0H3Q
FW_PACKAGE=STM32Cube_FW_N6              # + _V<FW_VERSION> in the CubeMX repository
FW_VERSION=1.4.1                        # the version STM32CubeMX 6.18.1 selects for this board
PROJECT_STRUCTURE=FSBL_ONLY             # one FSBL project in internal SRAM (dev boot mode load & run)
# Starting configuration: ST's FSBL-only reference template in the firmware package (clocks 800 MHz,
# caches, FullSecure context, Appli/ExtMemLoader not generated)
MX_TEMPLATE_IOC=Projects/STM32N6570-DK/Templates/Template/Template.ioc
# CubeMX script commands applied on top (';'-separated): the ST-LINK VCP console on USART1
MX_CONFIG="set context FSBL USART1;set mode USART1 Asynchronous;set pin PE5 USART1_TX;set pin PE6 USART1_RX"

# Build tools: STM32Cube bundles (%LOCALAPPDATA%\stm32cube\bundles), same pins as cubemx2-hal2-stm32c562nucleo
GCC_VERSION=14.3.1+st.2                 # gnu-tools-for-stm32
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0               # STM32CubeProgrammer (flash)
CLANGD_VERSION=21.1.0+st.2              # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2           # stlink-gdbserver (VS Code debug)

CONSOLE_BAUD=115200
