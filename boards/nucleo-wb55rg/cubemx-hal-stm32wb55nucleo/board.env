# Board TYPE profile: ST NUCLEO-WB55RG for the cubemx-hal-stm32wb55nucleo skill.
# Sourced by scripts/*.sh. Same for every board of this type; the ST-LINK serial and COM port of
# ONE board on ONE PC are NOT here: discover.sh writes them to <apps>/.bench/nucleo-wb55rg.env.

BOARD_ID=nucleo-wb55rg
BOARD_NAME="ST NUCLEO-WB55RG"
BOARD_DEFINE=BOARD_NUCLEO_WB55RG        # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="SW1,SW2,SW3"                # silkscreen names of BTN1,BTN2,... (comma-separated: no commas inside a label)
LED_LABELS="LED1 (blue),LED2 (green),LED3 (red)"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_WB
FW_VERSION=1.24.0
FW_BSP=P-NUCLEO-WB55.Nucleo             # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=STM32WB55RGV6
# Starting configuration: the CubeMX board configuration (USART1 on the VCP pins, MSI 32 MHz, SWD)
# without the board's other peripherals; then MX_CONFIG on top (';'-separated). CubeMX also has a
# P-NUCLEO-WB55-NUCLEO configuration: the same board, only the BSP name differs. STM32CubeMX2 1.1.2
# lists this board but cannot create a project for it (WB packs "incompatible", 2026-10-27).
MX_START="loadboard NUCLEO-WB55RG nomode"
# console: USART1 on PB6/PB7 = the ST-LINK/V2-1 virtual COM port (115200 8N1 = CubeMX default).
# clearpinout first: after this board's loadboard, "set mode USART1 Asynchronous" answers KO (also
# with allmodes, which leaves USART1 out) until the board's locked pins are cleared (2026-10-27).
# Board, clocks (MSI 32 MHz) and the BSP entry stay; LEDs/buttons are set up in src/board/board.c.
MX_CONFIG="clearpinout;set mode USART1 Asynchronous;set pin PB6 USART1_TX;set pin PB7 USART1_RX"
SYSCLK_HZ=32000000                      # board default clock tree (MSI range 10 = 32 MHz; SMPS clock from HSI)

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
IDE_EXT_VERSION=3.11.0                  # STM32CubeIDE for VS Code version the IDE path was proven with (update_tools.sh)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=NUCLEO-WB55RG
VSCODE_CORE=Cortex-M4

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME="STM32WB5x"        # prefix of "Device name" (read 2026-10-27: STM32WB5x/35xx)
EXPECTED_STLINK_BOARD=P-NUCLEO-WB55     # "Board" the on-board ST-LINK/V2-1 reports (read 2026-10-27, FW V2J45M31)
EXPECTED_DEVICE_ID=0x495                # "Device ID", read from the board 2026-10-27 (rev Y)
PROBE_VID=0483
PROBE_PID=374B                          # ST-LINK/V2-1 with VCP

CONSOLE_BAUD=115200
