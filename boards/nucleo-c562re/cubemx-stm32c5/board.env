# Board TYPE profile: ST NUCLEO-C562RE for the cubemx-stm32c5 skill. Sourced by scripts/*.sh.
# Same for every NUCLEO-C562RE. The ST-LINK serial and COM port of ONE board on ONE PC are NOT
# here: discover.sh writes them to <apps>/.bench/nucleo-c562re.env.

BOARD_ID=nucleo-c562re
BOARD_NAME="NUCLEO-C562RE"
BOARD_DEFINE=BOARD_NUCLEO_C562RE        # passed as -D to the app sources (CMake overlay)
BTN_LABELS="B1 (USER)"                  # silkscreen names of BTN1,BTN2,... (test prompts)

# STM32CubeMX2: the app's .ioc2 is created from the board, then configured with MX_CONFIG
MX_BOARD_CPN=NUCLEO-C562RE              # mx project create-from-board --cpn
MX_BOARD_PACK=nucleo-c562re_hw-board
MX_BOARD_PACK_VERSION=2.1.0
MX_CONFIG="USART2:Async"                # <peripheral>:<mode> pairs enabled after creation
BUILD_TYPE=debug                        # build target .<type>_GCC+<cpn>, preset <type>_GCC_<cpn>

# Pinned STM32Cube bundles (folder names under <stm32cube>/bundles/<tool>/)
MX_VERSION=1.1.1                        # stm32cubemx-application (bundles its own node)
NODE_VERSION=22.22.2+st.1
GCC_VERSION=14.3.1+st.2                 # gnu-tools-for-stm32
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
# Pinned CMSIS packs (<vendor>/<name>/<version> under <stm32cube>/packs)
PACKS="STMicroelectronics/stm32c5xx_dfp/2.1.0 STMicroelectronics/stm32c5xx_hal_drivers/2.1.0 STMicroelectronics/stm32cubemx2_templates_no_os_stm32c5/2.1.0 STMicroelectronics/nucleo-c562re_hw-board/2.1.0"

# Identity gate (STM32_Programmer_CLI hot-plug connect, read-only)
EXPECTED_DEVICE_NAME=STM32C5            # prefix of "Device name"
EXPECTED_STLINK_BOARD=NUCLEO-C562RE     # "Board" reported by the on-board ST-LINK (empty for external probes)
EXPECTED_DEVICE_ID=0x44E               # "Device ID", read from the board 2026-10-07 (device name STM32C5x)
PROBE_VID=0483
PROBE_PID=3754                          # STLINK-V3EC with VCP

CONSOLE_BAUD=115200
