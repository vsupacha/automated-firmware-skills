# Board TYPE profile: ST STM32F407G-DISC1 (STM32F4DISCOVERY) for the cubemx-hal-stm32f407disco skill.
# Sourced by scripts/*.sh. Same for every board of this type; probe serial of one board on one PC
# is NOT here (discover.sh writes it to <apps>/.bench/stm32f407g-disc1.env).

BOARD_ID=stm32f407g-disc1
BOARD_NAME="ST STM32F407G-DISC1 (STM32F4DISCOVERY)"
BOARD_DEFINE=BOARD_STM32F407G_DISC1     # passed as -D to the app sources (CMakeLists user section)
BTN_LABELS="B1"
LED_LABELS="LD3,LD4,LD5,LD6"

# STM32CubeMX (classic) + firmware package - pinned
CUBEMX_VERSION=6.18.1
FW_PACKAGE=STM32Cube_FW_F4
FW_VERSION=1.28.3
FW_BSP=STM32F4-Discovery                # Drivers/BSP/<name> in the package (pin facts)
MCU_CPN=STM32F407VGT6
# Starting configuration: the CubeMX board configuration (pins labelled, LEDs as outputs, B1, SWD,
# board clock tree) without the board's other peripherals; then MX_CONFIG on top (';'-separated)
MX_START="loadboard STM32F407G-DISC1 nomode"
MX_CONFIG="set mode SYS Trace_Asynchronous_SW"   # SWO on PB3: printf console through the ST-LINK
SYSCLK_HZ=25000000                      # board default clock tree (SWO speed is derived from it)

# Build tools: STM32Cube bundles, same pins as the other CubeMX skills
GCC_VERSION=14.3.1+st.2
CMAKE_VERSION=4.4.0+st.1
NINJA_VERSION=1.13.2+st.1
PROGRAMMER_VERSION=2.23.0
CLANGD_VERSION=21.1.0+st.2               # st-arm-clangd (STM32CubeIDE for VS Code indexing)
GDBSERVER_VERSION=7.14.0+st.2            # stlink-gdbserver (VS Code debug)
# STM32CubeIDE for VS Code project setup (written into mx/.settings by new_app/regen)
VSCODE_BOARD=STM32F407G-DISC1
VSCODE_CORE=Cortex-M4
EXPECTED_DEVICE_ID=0x413                # read 2026-10-07 (STM32F405xx/F407xx/F415xx/F417xx, rev Z)
