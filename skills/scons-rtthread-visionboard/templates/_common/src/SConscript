# src/board (board layer), src/func (function layer) and, when recipe at-cdc added it, src/at (AT
# command layer, a peer of the msh commands) of the app. src/*.c (hal_entry.c, the
# execution layer) is compiled by the project's root SConscript ('Applications' group).
from building import *

cwd = GetCurrentDir()
src = Glob('board/*.c') + Glob('func/*.c') + Glob('at/*.c')

# -Wextra on top of rtconfig.py's -Wall, for our layers only (not RT-Thread or the FSP)
group = DefineGroup('AppLayers', src, depend = [''], CPPPATH = [cwd], LOCAL_CFLAGS = ' -Wextra')

Return('group')
