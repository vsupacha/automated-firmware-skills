{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "info",            "send": "info",         "expect_re": ["INFO app=push-to-light .*leds=[0-9]+ btns=[0-9]+"]},
    {"name": "help",            "send": "help",         "expect": ["led <n> on|off|toggle"]},
    {"name": "led1 on",         "send": "led 1 on",     "expect": ["OK led1=1"], "pause": 0.8, "requires_re": "leds=[1-9]"},
    {"name": "readback led1=1", "send": "led",          "expect": ["led1=1"], "requires_re": "leds=[1-9]"},
    {"name": "led1 off",        "send": "led 1 off",    "expect": ["OK led1=0"], "pause": 0.8, "requires_re": "leds=[1-9]"},
    {"name": "led1 toggle",     "send": "led 1 toggle", "expect": ["OK led1=1"], "pause": 0.8, "requires_re": "leds=[1-9]"},
    {"name": "led2 on",         "send": "led 2 on",     "expect": ["OK led2=1"], "pause": 0.8, "requires_re": "leds=[2-9]"},
    {"name": "readback 1+2",    "send": "led",          "expect": ["led1=1", "led2=1"], "requires_re": "leds=[2-9]"},
    {"name": "led2 off",        "send": "led 2 off",    "expect": ["OK led2=0"], "requires_re": "leds=[2-9]"},
    {"name": "led1 off again",  "send": "led 1 off",    "expect": ["OK led1=0"], "requires_re": "leds=[1-9]"},
    {"name": "bad led",         "send": "led 9 on",     "expect": ["ERR no led9"]},
    {"name": "bad action",      "send": "led 1 blink",  "expect": ["ERR bad action"]},
    {"name": "unknown cmd",     "send": "foo",          "expect": ["command not found"]},
    {"name": "buttons released","send": "btn",          "expect_re": ["BTN( btn[0-9]=0)*$"]},
    {"name": "LED1 colour",     "interactive": true, "requires_re": "leds=[1-9]", "send": "led 1 on",
     "prompt": "Look at the RGB LED: LED1 (P102) is ON now - tell Claude its colour", "expect": ["OK led1=1"], "timeout": 5, "pause": 3},
    {"name": "LED1 off",        "interactive": true, "requires_re": "leds=[1-9]", "send": "led 1 off", "expect": ["OK led1=0"]},
    {"name": "LED2 colour",     "interactive": true, "requires_re": "leds=[2-9]", "send": "led 2 on",
     "prompt": "Look at the RGB LED: LED2 (P106) is ON now - tell Claude its colour", "expect": ["OK led2=1"], "timeout": 5, "pause": 3},
    {"name": "LED2 off",        "interactive": true, "requires_re": "leds=[2-9]", "send": "led 2 off", "expect": ["OK led2=0"]},
    {"name": "LED3 colour",     "interactive": true, "requires_re": "leds=[3-9]", "send": "led 3 on",
     "prompt": "Look at the RGB LED: LED3 (PA07) is ON now - tell Claude its colour", "expect": ["OK led3=1"], "timeout": 5, "pause": 3},
    {"name": "LED3 off",        "interactive": true, "requires_re": "leds=[3-9]", "send": "led 3 off", "expect": ["OK led3=0"]},
    {"name": "LED1 off before press", "interactive": true, "requires_re": "btns=[1-9]", "send": "led 1 off",
     "expect": ["OK led1=0"]},
    {"name": "BTN1 press",      "interactive": true, "requires_re": "btns=[1-9]", "prompt": "Press and release {btn1} once",
     "expect": ["EVT btn1=pressed", "EVT btn1=released"], "timeout": 30},
    {"name": "BTN2 press",      "interactive": true, "requires_re": "btns=[2-9]", "prompt": "Press and release {btn2}",
     "expect": ["EVT btn2=pressed", "EVT btn2=released"], "timeout": 30},
    {"name": "LED1 after press","interactive": true, "requires_re": "btns=[1-9]", "send": "led",
     "prompt": "Look at the board: LED1 (P102) should be ON now (tell Claude if it is)", "expect_re": ["LED led1=1"], "timeout": 5}
  ]
}
