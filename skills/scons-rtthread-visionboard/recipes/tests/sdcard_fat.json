{
  "title": "sdcard-fat: write, read back and delete a file on the SD card (FAT over msh)",
  "sync": {
    "send": "info",
    "expect": "READY"
  },
  "steps": [
    {
      "name": "card mounted",
      "send": "df /",
      "expect_re": [
        "disk free: [0-9.]+ [KMG]B"
      ]
    },
    {
      "name": "clean leftovers",
      "send": "rm -rf /fwtest",
      "pause": 0.5
    },
    {
      "name": "mkdir",
      "send": "mkdir /fwtest",
      "pause": 0.5
    },
    {
      "name": "write file",
      "send": "echo fwtest-fat-ok /fwtest/a.txt",
      "pause": 0.5
    },
    {
      "name": "read back",
      "send": "cat /fwtest/a.txt",
      "expect": [
        "fwtest-fat-ok"
      ]
    },
    {
      "name": "listed",
      "send": "ls /fwtest",
      "expect_re": [
        "a\\.txt\\s+\\d+"
      ]
    },
    {
      "name": "delete",
      "send": "rm -r /fwtest",
      "pause": 0.5
    },
    {
      "name": "gone",
      "send": "ls /fwtest",
      "expect": [
        "No such directory"
      ]
    }
  ]
}
