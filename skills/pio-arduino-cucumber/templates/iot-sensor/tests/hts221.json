{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "present",          "send": "info", "expect_re": ["^INFO app=iot-sensor .* hum=1 "]},
    {"name": "stream off",       "send": "stream off", "expect": ["OK stream=off"]},
    {"name": "read",             "send": "hum?", "expect_re": ["^HUM ok=1 rh=\\d+\\.\\d t=-?\\d+\\.\\d$"]},
    {"name": "rh 1..99 %",       "send": "hum?", "expect_re": ["^HUM ok=1 rh=[1-9]\\d?\\.\\d "]},
    {"name": "temp 0..59 degC",  "send": "hum?", "expect_re": ["^HUM ok=1 .* t=[0-5]?\\d\\.\\d$"]},
    {"name": "breathe on it",    "interactive": true, "prompt": "Breathe gently on the HTS221 for 3 s, then wait (the reading should rise - tell Claude the two rh values)",
     "send": "hum?", "expect_re": ["^HUM ok=1 rh="], "timeout": 10},
    {"name": "stream on",        "send": "stream on", "expect": ["OK stream=on"]}
  ]
}
