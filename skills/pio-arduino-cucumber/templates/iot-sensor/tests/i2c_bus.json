{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "stream off",       "send": "stream off", "expect": ["OK stream=off"]},
    {"name": "scan finds 3",     "send": "i2c?", "expect_re": ["^I2C n=3 addrs=0x5F,0x68,0x76$"], "timeout": 3},
    {"name": "scan again",       "send": "i2c?", "expect_re": ["^I2C n=3 addrs=0x5F,0x68,0x76$"], "timeout": 3},
    {"name": "stream on",        "send": "stream on", "expect": ["OK stream=on"]}
  ]
}
