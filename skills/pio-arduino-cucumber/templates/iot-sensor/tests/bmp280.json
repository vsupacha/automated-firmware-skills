{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "present",          "send": "info", "expect_re": ["^INFO app=iot-sensor .* baro=1 "]},
    {"name": "stream off",       "send": "stream off", "expect": ["OK stream=off"]},
    {"name": "read",             "send": "baro?", "expect_re": ["^BARO ok=1 p=\\d+\\.\\d t=-?\\d+\\.\\d$"]},
    {"name": "pressure 80..110 kPa", "send": "baro?", "expect_re": ["^BARO ok=1 p=(8\\d{4}|9\\d{4}|10\\d{4})\\.\\d "]},
    {"name": "temp 0..59 degC",  "send": "baro?", "expect_re": ["^BARO ok=1 .* t=[0-5]?\\d\\.\\d$"]},
    {"name": "stream on",        "send": "stream on", "expect": ["OK stream=on"]}
  ]
}
