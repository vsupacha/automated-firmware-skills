{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "present",          "send": "info", "expect_re": ["^INFO app=iot-sensor .* imu=1 "]},
    {"name": "stream off",       "send": "stream off", "expect": ["OK stream=off"]},
    {"name": "read",             "send": "imu?", "expect_re": ["^IMU ok=1 ax=-?\\d+\\.\\d\\d ay=-?\\d+\\.\\d\\d az=-?\\d+\\.\\d\\d gx=-?\\d+\\.\\d{3} gy=-?\\d+\\.\\d{3} gz=-?\\d+\\.\\d{3} t=-?\\d+\\.\\d$"]},
    {"name": "die temp 0..59",   "send": "imu?", "expect_re": ["^IMU ok=1 .* t=[0-5]?\\d\\.\\d$"]},
    {"name": "gravity on one axis (|a| 8..11)", "send": "imu?", "expect_re": ["^IMU ok=1 .*a[xyz]=-?(8|9|10|11)\\.\\d\\d"]},
    {"name": "board flat, face up", "interactive": true, "prompt": "Lay the board flat on the table, components up, and keep it still",
     "send": "imu?", "expect_re": ["^IMU ok=1 ax=-?[01]\\.\\d\\d ay=-?[01]\\.\\d\\d az=(8|9|10|11)\\.\\d\\d"], "timeout": 5},
    {"name": "stream on",        "send": "stream on", "expect": ["OK stream=on"]}
  ]
}
