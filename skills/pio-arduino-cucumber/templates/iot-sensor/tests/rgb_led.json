{
  "baud": 115200,
  "boot": {"expect": "READY", "timeout": 30},
  "sync": {"send": "info", "expect": "READY"},
  "steps": [
    {"name": "stream off",       "send": "stream off", "expect": ["OK stream=off"]},
    {"name": "red",              "send": "rgb 32 0 0", "expect": ["OK rgb=32,0,0"], "pause": 0.8},
    {"name": "read back red",    "send": "rgb?", "expect_re": ["^RGB r=32 g=0 b=0$"]},
    {"name": "green",            "send": "rgb 0 32 0", "expect": ["OK rgb=0,32,0"], "pause": 0.8},
    {"name": "blue",             "send": "rgb 0 0 32", "expect": ["OK rgb=0,0,32"], "pause": 0.8},
    {"name": "bad value",        "send": "rgb 0 0 300", "expect": ["ERR bad value"]},
    {"name": "bad usage",        "send": "rgb 1 2", "expect": ["ERR usage: rgb"]},
    {"name": "look: red",        "interactive": true, "send": "rgb 32 0 0", "prompt": "Look at the RGB LED: it should be RED now - tell Claude", "expect": ["OK rgb=32,0,0"], "timeout": 5},
    {"name": "off",              "send": "rgb 0 0 0", "expect": ["OK rgb=0,0,0"]},
    {"name": "stream on",        "send": "stream on", "expect": ["OK stream=on"]}
  ]
}
